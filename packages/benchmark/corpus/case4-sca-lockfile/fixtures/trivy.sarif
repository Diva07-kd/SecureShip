{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "rules": [
            {
              "id": "CVE-2021-23337",
              "name": "Command Injection in lodash",
              "shortDescription": { "text": "Command Injection in lodash via template" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-23337",
          "level": "error",
          "message": { "text": "Command injection vulnerability in lodash" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "package-lock.json" },
                "region": { "startLine": 6, "endLine": 6, "snippet": { "text": "\"version\": \"4.17.15\"" } }
              }
            }
          ],
          "properties": {
            "package": {
              "ecosystem": "npm",
              "name": "lodash",
              "version": "4.17.15",
              "fixedVersion": "4.17.21"
            },
            "aliases": ["CVE-2021-23337", "GHSA-35jh-r3h4-6jhm"],
            "lockfilePath": "package-lock.json"
          }
        }
      ]
    }
  ]
}
