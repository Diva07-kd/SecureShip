{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "rules": [
            {
              "id": "gitlab-pat",
              "name": "gitlab-pat",
              "shortDescription": {
                "text": "gitlab-pat"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "gitlab-pat",
          "level": "error",
          "message": {
            "text": "Finding for gitlab-pat"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/prod-keys.ts"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1,
                  "snippet": {
                    "text": "export const LIVE_PAT = \"glpat-secretlive1234567890\";"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
