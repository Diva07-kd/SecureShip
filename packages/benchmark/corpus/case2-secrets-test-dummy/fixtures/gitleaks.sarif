{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "rules": [
            {
              "id": "aws-access-key-id",
              "name": "aws-access-key-id",
              "shortDescription": {
                "text": "aws-access-key-id"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-key-id",
          "level": "error",
          "message": {
            "text": "Finding for aws-access-key-id"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/auth.test.ts"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1,
                  "snippet": {
                    "text": "const dummy = \"AKIAI44QH8DHBEMOCK01\";"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
