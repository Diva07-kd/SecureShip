{
  "name": "@secureship/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:replay": "node dist/cli.js --mode replay",
    "benchmark:live": "node dist/cli.js --mode live",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@secureship/contracts": "workspace:*",
    "@secureship/core-engine": "workspace:*",
    "@secureship/reachability": "workspace:*",
    "@secureship/scanner-adapters": "workspace:*",
    "@secureship/context-slicer": "workspace:*",
    "@secureship/ai": "workspace:*",
    "@secureship/patch-engine": "workspace:*",
    "@secureship/sandbox": "workspace:*",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
