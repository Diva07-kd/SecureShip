{
  "name": "@secureship/scanner-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs = require('fs'); fs.copyFileSync('src/supported-versions.json', 'dist/supported-versions.json'); fs.copyFileSync('src/tools.lock.json', 'dist/tools.lock.json');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@secureship/contracts": "workspace:*",
    "@secureship/core-engine": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
